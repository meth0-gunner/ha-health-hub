<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS is recommended (for example your Nabu Casa address). Plain HTTP is
     allowed so a local address like http://homeassistant.local:8123 also works. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
